{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sheetsift",
  "version": "0.0.0",
  "identifier": "com.luminousky.sheetsift",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev -- --mode tauri --strictPort",
    "beforeBuildCommand": "npm --prefix ../web run build -- --mode tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sheetsift",
        "width": 1280,
        "height": 840,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
